# Local Claude Code session config
.claude/

# Gradle / Android
android/.gradle/
android/local.properties
android/**/build/
android/**/.cxx/
*.hprof

# Native libraries staged by scripts/stage-jnilibs.sh from Nim/NDK build
# output (scripts/build-nim-android.sh + scripts/build-jni-shims.sh) -- build
# artifacts, not source; regenerate with those scripts rather than committing
# the .so's directly (see docs/adr/0003-jni-shim-per-module.md).
android/**/src/main/jniLibs/

# Nim build output
nim-src/*/build/
nim-src/*/nimcache/
nim-src/*/nimbledeps/

# Scratch build artifacts staged from CI
build/
